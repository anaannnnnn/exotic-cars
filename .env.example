# DevX Control's Switch to MongoDB action provides this variable.
# Set the database name to exotic_cars in the connection string.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/exotic_cars?retryWrites=true&w=majority

# Optional legacy aliases accepted by the server: MONGODB_URI or MONGO_URL.
# For deployments that use a generic database variable, DATABASE_URL may also
# contain a mongodb:// or mongodb+srv:// URI. A configured Mongo URI takes
# precedence over any stale Postgres URL.
